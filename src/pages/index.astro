---
import { getCollection, getEntry } from 'astro:content';
import { getImage, Picture } from 'astro:assets';
import Layout from '@/layouts/SiteLayout.astro';

export const prerender = true;

const [settingsEntry, aboutEntry, caseEntry, figures, services, brands, gallery, testimonials, resultCards] = await Promise.all([
  getEntry('siteSettings', 'index'), getEntry('about', 'index'), getEntry('caseStudy', 'index'),
  getCollection('figures'), getCollection('services'), getCollection('brands'), getCollection('gallery'), getCollection('testimonials'), getCollection('resultCards'),
]);
const settings = settingsEntry?.data;
const about = aboutEntry?.data;
const caseStudy = caseEntry?.data;
const ordered = <T extends { data: { order: number } }>(items: T[]) => items.sort((a, b) => a.data.order - b.data.order);
const cards = ordered(gallery);
const quotes = ordered(testimonials);
const description = settings?.seoDescription || 'Social media management and digital marketing by Ifeoluwa Odejinmi in Nigeria.';
const portrait = settings?.portrait ? await getImage({ src: settings.portrait, width: 900, format: 'avif' }) : undefined;
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || '';
const analyticsProvider = import.meta.env.PUBLIC_ANALYTICS_PROVIDER || 'plausible';
const analyticsId = import.meta.env.PUBLIC_ANALYTICS_ID || '';
---

<Layout title={settings?.seoTitle || 'Ifeoluwa Odejinmi'} description={description} image={settings?.socialImage || undefined} portrait={portrait?.src} personName={settings?.name || 'Ifeoluwa Odejinmi'} jobTitle={settings?.role || 'Social Media Manager and Digital Marketer'} linkedin={settings?.linkedinUrl} phone={settings?.phone}>
  <div class="wash" aria-hidden="true"></div>
  <div class="progress" aria-hidden="true"></div>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="topbar">
    <a class="wordmark" href="#top">Ifeoluwa Odejinmi<span>.</span></a>
    <nav aria-label="Main navigation">
      <a href="#about">About</a><a href="#services">Services</a><a href="#brands">Brands</a><a href="#work">Work</a><a href="#results">Results</a>
    </nav>
    <div class="nav-actions"><button class="theme-toggle glass" type="button" aria-label="Switch color theme"><span aria-hidden="true">◐</span></button><a class="pill glass" href="#contact">Get in touch <span aria-hidden="true">↗</span></a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu"><span></span><span></span></button></div>
    <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden><a href="#about">About</a><a href="#services">Services</a><a href="#brands">Brands</a><a href="#work">Work</a><a href="#results">Results</a><a href="#contact">Get in touch</a></nav>
  </header>
  <main id="main">
    <section class="hero wrap" id="top" aria-labelledby="hero-title">
      <div class="hero-copy"><p class="eyebrow">Nigeria <span>·</span> Social media & digital marketing</p><h1 id="hero-title">Ifeoluwa<br />Odejinmi<span>.</span></h1><p class="hero-intro">{settings?.heroIntro || settings?.role}</p><a class="text-link" href="#contact">Let’s work together <span aria-hidden="true">↘</span></a></div>
      <div class="portrait">{portrait ? <img src={portrait.src} width={portrait.attributes.width} height={portrait.attributes.height} alt="Portrait of Ifeoluwa Odejinmi" loading="eager" fetchpriority="high" /> : <span class="portrait-monogram" aria-hidden="true">IO</span>}</div>
      <p class="hero-caption">Social media manager<br />Digital marketer</p>
    </section>

    <section class="figures glass wrap reveal-group" aria-label="At a glance">
      {ordered(figures).map(({ data }) => <div class="figure reveal"><strong>{data.value}</strong><span>{data.label}</span></div>)}
      {figures.length === 0 && <p class="content-note">Add the four portfolio figures in Keystatic.</p>}
    </section>

    <section class="section wrap" id="about">
      <div class="section-head"><span class="eyebrow">01 / About</span><span class="eyebrow">The person behind the work</span></div>
      <div class="about-grid"><h2>{about?.heading || 'About'}</h2><div class="prose">{about?.paragraphs.map((paragraph) => <p>{paragraph}</p>)}{about?.platformsLine && <p class="platforms">{about.platformsLine}</p>}</div></div>
    </section>

    <section class="section wrap" id="services">
      <div class="section-head"><span class="eyebrow">02 / Services</span><span class="eyebrow">Strategy through to delivery</span></div>
      <h2 class="section-title">How I can help<span>.</span></h2>
      <ol class="service-list">{ordered(services).map(({ data }) => <li><h3>{data.title}</h3><p>{data.description}</p><span aria-hidden="true">↗</span></li>)}</ol>
      {settings?.toolsText && <p class="tools-text">{settings.toolsText}</p>}
    </section>

    <section class="section wrap" id="brands">
      <div class="section-head"><span class="eyebrow">03 / Brands</span><span class="eyebrow">Selected collaborations</span></div>
      <div class="brand-grid">{ordered(brands).map(({ data }) => <article class="brand-card"><h3>{data.name}</h3>{data.descriptor && <p>{data.descriptor}</p>}<ul>{data.bullets.map((bullet) => <li>{bullet}</li>)}</ul></article>)}</div>
      {brands.length === 0 && <p class="content-note">Forevermore Group · Yard.ng · Calidad Foods · Chila Bel</p>}
    </section>

    <section class="section wrap case-study" aria-labelledby="case-title">
      <div class="section-head"><span class="eyebrow">04 / Case study</span><span class="eyebrow">Yard.ng</span></div>
      <h2 id="case-title">{caseStudy?.title || 'Yard.ng'}<span>.</span></h2>
      <div class="prose">{caseStudy?.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
    </section>

    <section class="section wrap" id="work">
      <div class="section-head"><span class="eyebrow">05 / Selected work</span><span class="eyebrow">Content & campaigns</span></div>
      <h2 class="section-title">The work<span>.</span></h2>
      <div class="gallery">
        {cards.map(({ data }) => {
          const still = data.poster || data.image;
          return <button class="gallery-item" type="button" data-gallery-item data-kind={data.type} data-caption={data.caption} data-mp4={data.mp4 || ''} data-webm={data.webm || ''} aria-label={`${data.type === 'video' ? 'Play' : 'View'} ${data.caption}`}>
            {still && <Picture src={still} alt={data.caption} width={800} height={720} formats={['avif', 'webp']} loading="lazy" />}
            {!still && <span class="media-missing">{data.caption}</span>}
            {data.type === 'video' && <span class="play-icon" aria-hidden="true">▶</span>}
            <span class="gallery-caption">{data.caption}</span>
          </button>;
        })}
      </div>
    </section>

    <section class="section wrap" aria-labelledby="testimonial-heading">
      <div class="section-head"><span class="eyebrow">06 / Testimonial content</span><span class="eyebrow">Created for clients</span></div>
      <h2 id="testimonial-heading" class="section-title">Words in context<span>.</span></h2>
      {quotes.length > 0 && <div class="quote-panel glass" data-carousel aria-roledescription="carousel">
        <p class="quote-count"><span data-slide-number>1</span> / {quotes.length}</p>
        {quotes.map(({ data }, i) => <figure data-slide={i} hidden={i !== 0}><blockquote>{data.quote}</blockquote><figcaption>{data.attribution}</figcaption></figure>)}
        <div class="carousel-controls"><button type="button" data-prev aria-label="Previous testimonial">←</button><button type="button" data-next aria-label="Next testimonial">→</button></div>
      </div>}
    </section>

    <section class="section wrap" id="results">
      <div class="section-head"><span class="eyebrow">07 / Results</span><span class="eyebrow">Measured outcomes</span></div>
      <h2 class="section-title">The numbers<span>.</span></h2>
      <div class="results-grid">{ordered(resultCards).map(({ data }) => <article class="result-card glass"><h3>{data.title}</h3>{data.period && <small>{data.period}</small>}{data.rows.map((row) => <div class="result-row"><span>{row.label}</span><strong>{row.value}</strong></div>)}{data.note && <p class="result-note">{data.note}</p>}</article>)}</div>
    </section>

    <section class="contact-section section wrap" id="contact">
      <div class="section-head"><span class="eyebrow">08 / Get in touch</span><span class="eyebrow">Let’s start a conversation</span></div>
      <h2>Have a project<br />in mind<span>?</span></h2>
      <div class="contact-grid">
        <div class="contact-details">
          {settings?.phone && <a class="pill glass track-event" data-event="phone_click" href={`tel:${settings.phone}`}>Call <span>{settings.phone}</span></a>}
          {settings?.linkedinUrl && <a class="pill glass track-event" data-event="linkedin_click" href={settings.linkedinUrl} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>}
          {settings?.email && <a class="email-link" href={`mailto:${settings.email}`}>{settings.email}</a>}
        </div>
        <form class="contact-form" action={endpoint || '#contact'} method="POST" data-contact-form>
          <label>Name<input id="contact-name" name="name" autocomplete="name" aria-describedby="contact-name-error" required minlength="2" /><span class="field-error" id="contact-name-error" data-field-error hidden></span></label>
          <label>Email<input id="contact-email" name="email" type="email" autocomplete="email" aria-describedby="contact-email-error" required /><span class="field-error" id="contact-email-error" data-field-error hidden></span></label>
          <label>Brand or company <span>(optional)</span><input name="company" autocomplete="organization" /></label>
          <label>Message<textarea id="contact-message" name="message" rows="4" aria-describedby="contact-message-error" required minlength="10"></textarea><span class="field-error" id="contact-message-error" data-field-error hidden></span></label>
          <div class="honeypot" aria-hidden="true"><label>Leave this field empty<input name="_gotcha" tabindex="-1" autocomplete="off" /></label></div>
          <p class="form-error" data-error hidden></p>
          <button class="pill glass submit-button" type="submit">Send a message <span aria-hidden="true">↗</span></button>
          <p class="form-status" aria-live="polite" role="status" data-status></p>
        </form>
      </div>
    </section>
  </main>
  <footer class="footer wrap"><a class="wordmark" href="#top">Ifeoluwa Odejinmi<span>.</span></a><span>Social media manager & digital marketer</span><a href="#top">Back to top ↑</a><small>© {new Date().getFullYear()} Ifeoluwa Odejinmi</small></footer>

  <dialog class="lightbox" aria-label="Selected work" data-lightbox>
    <button class="lightbox-close" type="button" aria-label="Close gallery">×</button>
    <button class="lightbox-prev" type="button" aria-label="Previous item">←</button>
    <div class="lightbox-content"></div>
    <button class="lightbox-next" type="button" aria-label="Next item">→</button>
    <p class="lightbox-caption"></p>
  </dialog>

  <script define:vars={{ endpoint, analyticsProvider, analyticsId }}>
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dnt = () => ['1', 'yes'].includes((navigator.doNotTrack || window.doNotTrack || '').toLowerCase());
    const analytics = (name, props = {}) => {
      if (!analyticsProvider || !analyticsId || dnt()) return;
      if (analyticsProvider === 'plausible' && window.plausible) window.plausible(name, { props });
      if (analyticsProvider === 'ga4' && window.gtag) window.gtag('event', name, props);
    };
    const themeButton = document.querySelector('.theme-toggle');
    try {
      const saved = localStorage.getItem('theme');
      if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
    } catch {}
    themeButton?.addEventListener('click', () => {
      const current = document.documentElement.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
    });
    const menuButton = document.querySelector('.menu-toggle');
    menuButton?.addEventListener('click', () => {
      const nav = document.querySelector('#mobile-nav');
      const expanded = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!expanded));
      menuButton.setAttribute('aria-label', expanded ? 'Open menu' : 'Close menu');
      nav.hidden = expanded;
    });
    if (!reducedMotion && 'IntersectionObserver' in window) {
      document.documentElement.classList.add('js-reveals');
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
      }), { threshold: 0.15 });
      document.querySelectorAll('.section, .figure, .brand-card, .result-card').forEach((el, index) => {
        el.style.setProperty('--reveal-delay', `${(index % 4) * 90}ms`); observer.observe(el);
      });
    }
    if (!reducedMotion) {
      const progress = document.querySelector('.progress');
      let ticking = false;
      addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const max = document.documentElement.scrollHeight - innerHeight;
          progress.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
          document.querySelector('.wash').style.setProperty('--wash-shift', `${scrollY * 0.025}px`);
          ticking = false;
        });
      }, { passive: true });
    }
    const form = document.querySelector('[data-contact-form]');
    form?.addEventListener('invalid', (event) => {
      const field = event.target;
      const hint = form.querySelector(`#${field.id}-error`);
      if (!hint) return;
      field.setAttribute('aria-invalid', 'true');
      hint.hidden = false;
      hint.textContent = field.validity.valueMissing ? 'Please complete this field.' : field.validity.typeMismatch ? 'Enter a valid email address.' : 'Please add a little more detail.';
    }, true);
    form?.addEventListener('submit', async (event) => {
      const data = new FormData(form);
      const status = form.querySelector('[data-status]');
      const error = form.querySelector('[data-error]');
      error.hidden = true;
      if (data.get('_gotcha')) { event.preventDefault(); status.textContent = 'Thanks. Your message has been sent.'; return; }
      const fields = [...form.querySelectorAll('input[required], textarea[required]')];
      const firstInvalid = fields.find((field) => !field.checkValidity());
      fields.forEach((field) => {
        const hint = form.querySelector(`#${field.id}-error`);
        const invalid = !field.checkValidity();
        field.setAttribute('aria-invalid', String(invalid));
        if (hint) { hint.hidden = !invalid; hint.textContent = invalid ? (field.validity.valueMissing ? 'Please complete this field.' : field.validity.typeMismatch ? 'Enter a valid email address.' : 'Please add a little more detail.') : ''; }
      });
      if (firstInvalid) { event.preventDefault(); firstInvalid.focus(); status.textContent = 'Please correct the highlighted fields.'; return; }
      fields.forEach((field) => field.removeAttribute('aria-invalid'));
      if (!endpoint) { status.textContent = 'The contact form is not configured yet. Please use the contact links above.'; return; }
      event.preventDefault();
      const submit = form.querySelector('[type=submit]');
      submit.disabled = true; status.textContent = 'Sending…';
      try {
        const response = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error('Message could not be sent');
        status.textContent = 'Thanks. Your message has been sent.'; form.reset(); analytics('contact_form_submit');
      } catch {
        error.hidden = false; error.textContent = 'Your message could not be sent. Please try again or use the contact links above.';
        status.textContent = 'Message not sent.';
      } finally { submit.disabled = false; }
    });
    form?.addEventListener('input', (event) => {
      const field = event.target;
      if (!field.matches('input[required], textarea[required]')) return;
      const hint = form.querySelector(`#${field.id}-error`);
      if (field.checkValidity()) { field.removeAttribute('aria-invalid'); if (hint) { hint.hidden = true; hint.textContent = ''; } }
    });
    document.querySelectorAll('.track-event').forEach((link) => link.addEventListener('click', () => analytics(link.dataset.event)));
    const items = [...document.querySelectorAll('[data-gallery-item]')];
    const dialog = document.querySelector('[data-lightbox]');
    const content = dialog.querySelector('.lightbox-content');
    let current = 0, opener = null;
    const showItem = (index) => {
      current = (index + items.length) % items.length;
      const item = items[current], kind = item.dataset.kind;
      const image = item.querySelector('img');
      const caption = item.dataset.caption;
      content.replaceChildren();
      if (kind === 'video' && (item.dataset.mp4 || item.dataset.webm)) {
        const video = document.createElement('video'); video.controls = true; video.playsInline = true; video.muted = true; video.preload = 'none';
        if (image) video.poster = image.currentSrc || image.src;
        if (item.dataset.mp4) { const source = document.createElement('source'); source.src = item.dataset.mp4; source.type = 'video/mp4'; video.append(source); }
        if (item.dataset.webm) { const source = document.createElement('source'); source.src = item.dataset.webm; source.type = 'video/webm'; video.append(source); }
        content.append(video); video.addEventListener('play', () => analytics('video_played', { caption }));
        video.play().catch(() => {});
      } else if (image) {
        const img = document.createElement('img'); img.src = image.currentSrc || image.src; img.alt = image.alt; img.width = image.naturalWidth || 800; img.height = image.naturalHeight || 720; content.append(img);
      } else { const missing = document.createElement('p'); missing.textContent = caption; content.append(missing); }
      dialog.querySelector('.lightbox-caption').textContent = caption;
      analytics('gallery_item_opened', { caption });
    };
    items.forEach((item, index) => item.addEventListener('click', () => { opener = item; showItem(index); dialog.showModal(); dialog.querySelector('.lightbox-close').focus(); }));
    if (items.length) {
      dialog.querySelector('.lightbox-prev').addEventListener('click', () => showItem(current - 1));
      dialog.querySelector('.lightbox-next').addEventListener('click', () => showItem(current + 1));
    }
    dialog.querySelector('.lightbox-close').addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => { content.querySelector('video')?.pause(); opener?.focus(); });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight' && items.length) showItem(current + 1);
      if (event.key === 'ArrowLeft' && items.length) showItem(current - 1);
      if (event.key === 'Tab') {
        const focusable = [...dialog.querySelectorAll('button:not([disabled])')];
        if (event.shiftKey && document.activeElement === focusable[0]) { event.preventDefault(); focusable.at(-1).focus(); }
        else if (!event.shiftKey && document.activeElement === focusable.at(-1)) { event.preventDefault(); focusable[0].focus(); }
      }
    });
    const carousel = document.querySelector('[data-carousel]');
    if (carousel) {
      const slides = [...carousel.querySelectorAll('[data-slide]')]; let slide = 0;
      const change = (direction) => { slides[slide].hidden = true; slide = (slide + direction + slides.length) % slides.length; slides[slide].hidden = false; carousel.querySelector('[data-slide-number]').textContent = String(slide + 1); };
      carousel.querySelector('[data-prev]').addEventListener('click', () => change(-1));
      carousel.querySelector('[data-next]').addEventListener('click', () => change(1));
    }
  </script>
  {analyticsProvider && analyticsId && <script is:inline define:vars={{ analyticsProvider, analyticsId }}>
    if (!['1', 'yes'].includes((navigator.doNotTrack || window.doNotTrack || '').toLowerCase())) {
      if (analyticsProvider === 'plausible') {
        const s = document.createElement('script'); s.defer = true; s.dataset.domain = location.hostname; s.src = 'https://plausible.io/js/script.js'; document.head.append(s);
        window.plausible = window.plausible || function(){ (window.plausible.q = window.plausible.q || []).push(arguments); };
      } else if (analyticsProvider === 'ga4') {
        const s = document.createElement('script'); s.async = true; s.src = `https://www.googletagmanager.com/gtag/js?id=${analyticsId}`; document.head.append(s);
        window.dataLayer = window.dataLayer || []; window.gtag = function(){ window.dataLayer.push(arguments); }; window.gtag('js', new Date()); window.gtag('config', analyticsId, { anonymize_ip: true, client_storage: 'none' });
      }
    }
  </script>}
</Layout>
