---
import '@fontsource/bricolage-grotesque/300.css';
import '@fontsource/bricolage-grotesque/400.css';
import '@fontsource/bricolage-grotesque/600.css';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@/styles/global.css';
interface Props { title: string; description: string; image?: ImageMetadata; portrait?: string; personName: string; jobTitle: string; linkedin?: string; phone?: string; }
const { title, description, image, portrait, personName, jobTitle, linkedin, phone } = Astro.props;
const site = import.meta.env.PUBLIC_SITE_URL || 'https://example.com';
const canonical = new URL(Astro.url.pathname, site).toString();
const social = image ? new URL(image.src, site).toString() : new URL('/og-image.png', site).toString();
const person = {
  '@context': 'https://schema.org', '@type': 'Person', name: personName, jobTitle, url: site,
  sameAs: linkedin ? [linkedin] : [], telephone: phone || undefined,
};
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: personName, url: site };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FBFBFA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0A1128" media="(prefers-color-scheme: dark)" />
    {portrait && <link rel="preload" as="image" href={portrait} fetchpriority="high" />}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={social} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={social} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" /><link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify([person, website])} />
  </head>
  <body><slot /></body>
</html>
